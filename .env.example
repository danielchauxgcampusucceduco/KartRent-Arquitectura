# Copia este archivo como .env y cambia los valores antes de "docker compose up".
# WEBHOOK_SECRET: mínimo 16 caracteres (firma HMAC-SHA256 del webhook de la pasarela).
# Las claves del personal: mínimo 8 caracteres.
WEBHOOK_SECRET=cambia-por-un-secreto-largo-y-aleatorio
ADMIN_PASSWORD=cambia-admin
BOXES_PASSWORD=cambia-boxes
CRONOMETRAJE_PASSWORD=cambia-cronometraje
MECANICO_PASSWORD=cambia-mecanico
