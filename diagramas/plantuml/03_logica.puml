@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FFF7D6
  BorderColor #1F2733
  ArrowColor #1F2733
  StereotypeFontColor #8A5A00
}
hide empty members
title Vista lógica - Modelo de dominio de KartRent (patrones GRASP)

' ================= Controladores (casos de uso) =================
class ReservarTanda <<Controlador>> {
  + ejecutar(documento : String, codigoSesion : String, cupos : int) : Reserva
}
class PagarReserva <<Controlador>> {
  + ejecutar(codigoReserva : UUID, metodo : MetodoPago, claveIdempotencia : String) : Resultado
  + procesarWebhook(cuerpo : String, firma : String) : Resultado
  + confirmarDesdePasarela(referencia : String, aprobado : boolean) : Resultado
}
class CancelarReserva <<Controlador>> {
  + ejecutar(codigoReserva : UUID) : Reserva
}
class CancelarTanda <<Controlador>> {
  + ejecutar(codigoSesion : String) : SesionPista
}
class ControlarSesion <<Controlador>> {
  + parrilla(codigoSesion : String) : Parrilla
  + asignarKart(codigoSesion : String, codigoReserva : UUID, documentoPiloto : String, numeroKart : int) : AsignacionKart
  + desasignarKart(codigoSesion : String, numeroKart : int) : void
  + iniciar(codigoSesion : String) : SesionPista
  + finalizar(codigoSesion : String) : Cierre
}
class RegistrarPaso <<Controlador>> {
  + ejecutar(codigoTransponder : String, marcaTiempo : Instant) : Optional<VueltaRegistrada>
}
class GestionarOrdenes <<Controlador>> {
  + asignar(numeroOrden : String, codigoMecanico : String) : OrdenMantenimiento
  + cerrar(numeroOrden : String, codigoMecanico : String, observaciones : String) : OrdenMantenimiento
}

' ================= Personas =================
abstract class Persona <<Experto>> {
  # documento : String
  # nombre : String
  # correo : String
  # telefono : String
}
class Cliente <<Experto>> {
  - fechaNacimiento : LocalDate
  - exoneracionFirmada : boolean
  - fechaExoneracion : LocalDate
  + firmarExoneracion(fecha : LocalDate) : void
  + calcularEdad(hoy : LocalDate) : int
  + puedeConducir(edadMinima : int, hoy : LocalDate) : boolean
}
class Mecanico <<Experto>> {
  - codigoEmpleado : String
  - especialidad : String
  + puedeAtender(tipo : TipoMantenimiento) : boolean
}

' ================= Reservas y facturación =================
class Reserva <<Experto>> <<Creador>> {
  - codigo : UUID
  - fechaCreacion : LocalDateTime
  - cantidadCupos : int
  - valorTotal : BigDecimal
  - estado : EstadoReserva
  - venceRetencion : LocalDateTime
  + {static} crear(cliente, sesion, cupos, tarifa, ahora, retencion) : Reserva
  + {static} calcularTotal(tarifaPorCupo : BigDecimal, cupos : int) : BigDecimal
  + verificarPagable(ahora : LocalDateTime) : void
  + registrarPago(referencia : String, metodo : MetodoPago, aprobado : boolean, ahora : LocalDateTime) : Pago
  + confirmar(pago : Pago) : void
  + expirar(ahora : LocalDateTime) : boolean
  + cancelar() : void
  + reembolsar() : void
}
class Tarifa <<Experto>> {
  - tipoKart : TipoKart
  - valorPorCupo : BigDecimal
  - vigenteDesde : LocalDate
}
class Pago <<Experto>> {
  - referenciaPasarela : String
  - monto : BigDecimal
  - metodo : MetodoPago
  - aprobado : boolean
  - reembolsado : boolean
  - fechaPago : LocalDateTime
  + esAprobado() : boolean
  + reembolsar() : Pago
}
class Factura <<Experto>> {
  - numero : String
  - cufe : String
  - fechaEmision : LocalDateTime
  - subtotal : BigDecimal
  - iva : BigDecimal
  - total : BigDecimal
  + {static} emitir(numero, codigoReserva, totalConIva, nitEmisor, ahora) : Factura
  + {static} calcularIva(base : BigDecimal) : BigDecimal
}

' ================= Pista =================
class SesionPista <<Experto>> <<Creador>> {
  - codigo : String
  - horaInicioProgramada : LocalDateTime
  - duracionMinutos : int
  - cuposMaximos : int
  - cuposVendidos : int
  - tipoKart : TipoKart
  - estado : EstadoSesion
  - version : long
  + {static} programar(codigo, inicio, duracionMinutos, cupos, tipoKart) : SesionPista
  + cuposDisponibles() : int
  + reservarCupos(cantidad : int) : void
  + liberarCupos(cantidad : int) : void
  + asignarKart(codigoReserva : UUID, documento : String, nombre : String, edad : int, kart : Kart) : AsignacionKart
  + desasignarKart(numeroKart : int) : AsignacionKart
  + liberarCuposDeReserva(codigoReserva : UUID, cupos : int) : void
  + cancelar() : List<AsignacionKart>
  + iniciar(ahora : LocalDateTime) : void
  + finalizar(ahora : LocalDateTime, longitudPistaM : double) : List<UsoKart>
  + obtenerClasificacion() : List<LineaClasificacion>
}
class AsignacionKart <<Experto>> <<Creador>> {
  - numeroParrilla : int
  - codigoReserva : UUID
  - documentoPiloto : String
  - numeroKart : int
  - codigoTransponder : String
  - ultimoPaso : Instant
  + registrarPaso(marca : Instant, tiempoMinimo : Duration) : Optional<VueltaTelemetria>
  + mejorVuelta() : Optional<VueltaTelemetria>
  + totalVueltas() : int
}
class VueltaTelemetria <<Experto>> {
  - numeroVuelta : int
  - marcaTiempo : Instant
  - tiempoVuelta : Duration
  + esValida(tiempoMinimo : Duration) : boolean
  + velocidadPromedio(longitudPistaM : double) : double
}

' ================= Flota =================
abstract class Kart <<Experto>> <<Polimorfismo>> {
  - numeroKart : int
  - estado : EstadoKart
  - kilometraje : double
  - horasMotor : double
  - horasDesdeUltimoServicio : double
  + estaDisponible() : boolean
  + ponerEnPista() : void
  + liberar() : void
  + registrarUso(minutos : int, km : double) : void
  + requiereMantenimiento(umbralHoras : double) : boolean
  + bloquear() : void
  + habilitar() : void
  + {abstract} tipo() : TipoKart
  + edadMinimaPiloto() : int
}
class KartAdulto <<Polimorfismo>> {
  + tipo() : TipoKart
}
class KartInfantil <<Polimorfismo>> {
  + tipo() : TipoKart
  + edadMaximaPiloto() : int
}
class Transponder <<Experto>> {
  - codigoTransponder : String
  - nivelBateria : int
  - activo : boolean
  + vincular(kart : Kart) : void
  + requiereCarga(umbral : int) : boolean
}
class OrdenMantenimiento <<Experto>> {
  - numero : String
  - tipo : TipoMantenimiento
  - estado : EstadoOrden
  - fechaApertura : LocalDateTime
  - fechaCierre : LocalDateTime
  - horasMotorAlAbrir : double
  - observaciones : String
  + {static} preventiva(numero : String, kart : Kart, ahora : LocalDateTime) : OrdenMantenimiento
  + asignar(mecanico : Mecanico) : void
  + cerrar(codigoMecanicoQueCierra : String, observaciones : String, kart : Kart, ahora : LocalDateTime) : void
}

enum EstadoReserva {
  PENDIENTE_PAGO
  CONFIRMADA
  CANCELADA
  EXPIRADA
  REEMBOLSADA
}
enum EstadoSesion {
  PROGRAMADA
  EN_PARRILLA
  EN_CURSO
  FINALIZADA
  CANCELADA
}
enum TipoKart {
  ADULTO
  INFANTIL
}
enum MetodoPago {
  TARJETA
  PSE
  NEQUI
  SIMULAR_RECHAZO
}
enum TipoMantenimiento {
  PREVENTIVO
  CORRECTIVO
}

enum EstadoOrden {
  ABIERTA
  EN_PROCESO
  CERRADA
}

enum EstadoKart {
  DISPONIBLE
  EN_PISTA
  EN_MANTENIMIENTO
  FUERA_DE_SERVICIO
}

' ================= Relaciones =================
Persona <|-- Cliente
Persona <|-- Mecanico
Kart <|-- KartAdulto
Kart <|-- KartInfantil

Cliente "1" -- "0..*" Reserva : realiza >
Reserva "0..*" --> "1" SesionPista : cupos en >
Reserva ..> Tarifa : valora con
Reserva "1" o-- "0..*" Pago : registra
Reserva "1" -- "0..1" Factura : genera >
SesionPista "1" *-- "0..*" AsignacionKart : parrilla
AsignacionKart "1" *-- "0..*" VueltaTelemetria : vueltas
AsignacionKart "0..*" --> "1" Kart : usa
Kart "1" -- "0..1" Transponder : lleva >
Kart "1" -- "0..*" OrdenMantenimiento : < atiende
OrdenMantenimiento "0..*" --> "0..1" Mecanico : asignada a

Reserva --> EstadoReserva
Pago --> MetodoPago
SesionPista --> EstadoSesion
SesionPista --> TipoKart
Tarifa --> TipoKart
Kart --> EstadoKart
Kart ..> TipoKart
OrdenMantenimiento --> TipoMantenimiento
OrdenMantenimiento --> EstadoOrden

ReservarTanda ..> Reserva : <<crea>>
PagarReserva ..> Factura : <<emite>>
CancelarReserva ..> Reserva
CancelarTanda ..> SesionPista
ControlarSesion ..> SesionPista
RegistrarPaso ..> AsignacionKart
GestionarOrdenes ..> OrdenMantenimiento
@enduml
