@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center
title Secuencia - POST /api/v1/reservas (HU-01): éxito 201 y errores 404, 409 y 400

actor "Piloto" as P
participant "Piloto.tsx\n(api.reservar)" as UI
participant "ReservasController\nreservar()" as C
participant "ReservarTanda\nejecutar()" as UC
participant "UnidadDeTrabajo\nejecutarConReintentos()" as UOW
participant "RepositorioClientes\nRepositorioSesiones\nRepositorioTarifas" as R1
participant "Reserva\ncrear()" as RES
participant "SesionPista\nreservarCupos()" as S
participant "RepositorioReservas\nRepositorioSesiones.guardar()" as R2
participant "ManejadorErrores" as E

P -> UI : elige tanda y cupos
UI -> C : POST /api/v1/reservas\n{documentoCliente, codigoSesion, cupos}
C -> UC : ejecutar(documento, codigoSesion, cupos)
UC -> UOW : ejecutarConReintentos(trabajo)
UOW -> R1 : buscar(documento), buscar(codigoSesion), vigente(tipoKart, hoy)

alt el cliente o la tanda no existen
  R1 --> UOW : Optional vacío
  UOW --> E : RecursoNoEncontradoException
  E --> UI : 404 Problem Details "Cliente … no registrado"
  UI --> P : formulario de registro (Registro)
else no hay tarifa vigente
  UOW --> E : ConflictoException
  E --> UI : 409 "No hay tarifa vigente…"
else existen
  UOW -> RES : crear(cliente, sesion, cupos, tarifa, ahora, retencion)
  alt sin exoneración o edad fuera del rango (RN-02, RN-03)
    RES --> E : ReglaNegocioException
    E --> UI : 400 "Regla de negocio incumplida"
  else tanda ya comenzó
    RES --> E : ConflictoException
    E --> UI : 409 "La tanda … ya comenzó"
  else datos válidos
    RES -> S : reservarCupos(cupos)
    alt cupos insuficientes o tanda cerrada
      S --> E : ConflictoException("Cupos insuficientes")
      E --> UI : 409 "Conflicto con el estado actual"
    else hay cupos
      S --> RES : cuposVendidos += cupos
      RES --> UOW : Reserva PENDIENTE_PAGO (vence en 10 min)
      UOW -> R2 : guardar(sesion) con version, guardar(reserva)
      alt otra transacción cambió la tanda (version distinta)
        R2 --> UOW : ConflictoConcurrenciaException
        UOW -> UOW : repite el caso de uso (hasta 10 intentos)
        note right: si se agotan los intentos\nresponde 409
      else guardado
        R2 --> UOW : ok
        UOW --> UC : Reserva
        UC --> C : Reserva
        C --> UI : 201 ReservaDto {codigo, estado, venceRetencion}
        UI --> P : cuenta regresiva de la retención
      end
    end
  end
end
@enduml
