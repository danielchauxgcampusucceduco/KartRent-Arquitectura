@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam componentStyle uml2
skinparam component {
  BackgroundColor #7FD3F7
  BorderColor #1F2733
}
title Vista funcional - Componentes de negocio KartRent

component "Gestión de Pista y Telemetría" as PIS
component "Gestión de Reservas y Clientes" as RES
component "Gestión de Flota y Mantenimiento" as FLO
component "Configuración y Reportes" as CFG
component "Gestión de Pagos y Facturación" as PAG
component "Notificaciones" as NOT

PIS ..> RES : Consulta pilotos con reserva confirmada
PIS ..> FLO : Consulta karts disponibles y reporta uso
RES ..> CFG : Consulta tarifas y tandas programadas
FLO ..> CFG : Consulta umbral de mantenimiento
RES ..> PAG : Solicita cobro de la reserva
CFG ..> PAG : Consulta ingresos para reportes
PAG ..> NOT : Solicita envío de confirmación y factura
FLO ..> NOT : Solicita alerta al taller
@enduml
