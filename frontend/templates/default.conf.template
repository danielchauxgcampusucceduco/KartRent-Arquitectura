# Sirve la SPA y hace de proxy inverso hacia el backend (REST + WebSocket STOMP).
# BACKEND_URL: http://backend:8080 con docker compose; la URL pública del backend en un despliegue en la nube.
server {
    listen 80;
    root /usr/share/nginx/html;

    proxy_ssl_server_name on;

    location /api/ { proxy_pass ${BACKEND_URL}; }
    location ~ ^/(swagger-ui|v3/api-docs) { proxy_pass ${BACKEND_URL}; }
    # Actuator: hacia afuera solo se expone la salud; el resto (info, etc.) queda dentro de la red de contenedores.
    location = /actuator/health { proxy_pass ${BACKEND_URL}; }
    location /actuator { return 404; }
    location /ws {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
    }
    location / { try_files $uri /index.html; }
}
